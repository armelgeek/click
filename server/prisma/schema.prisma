// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses      Address[]
  paymentMethods PaymentMethod[]
  orders         Order[]
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String
  streetAddress String
  city          String
  state         String
  postalCode    String
  country       String
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model PaymentMethod {
  id          String   @id @default(cuid())
  userId      String
  type        String // card, paypal, other
  provider    String
  token       String?
  last4       String?
  cardBrand   String?
  expiryMonth Int?
  expiryYear  Int?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model Order {
  id               String   @id @default(cuid())
  userId           String
  addressId        String
  paymentMethodId  String
  status           String   @default("pending") // pending, confirmed, preparing, in_delivery, delivered, cancelled
  totalAmount      Float
  currency         String   @default("EUR")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  address       Address       @relation(fields: [addressId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  items         OrderItem[]
  delivery      Delivery?
  payment       Payment?
  rating        OrderRating?
  returnRequest OrderReturn?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  name     String
  quantity Int
  price    Float
  image    String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id               String   @id @default(cuid())
  orderId          String   @unique
  paymentIntentId  String   @unique
  status           String // succeeded, failed, requires_action
  amount           Float
  currency         String
  transactionId    String?
  clientSecret     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([paymentIntentId])
}

model Delivery {
  id                   String   @id @default(cuid())
  orderId              String   @unique
  status               String   @default("preparing") // preparing, ready, picked_up, on_the_way, nearby, delivered, failed, returned
  estimatedTimeMinutes Int      @default(25)
  driverId             String?
  driverName           String?
  driverPhone          String?
  driverPhoto          String?
  driverVehicleType    String?
  driverRating         Float?
  currentLatitude      Float?
  currentLongitude     Float?
  currentAddress       String?
  destinationLatitude  Float?
  destinationLongitude Float?
  destinationAddress   String?
  shopLatitude         Float?
  shopLongitude        Float?
  shopAddress          String?
  canCall              Boolean  @default(false)
  canMessage           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  timeline        DeliveryTimeline[]
  messageExchange DeliveryMessage[]

  @@index([orderId])
  @@index([status])
}

model DeliveryTimeline {
  id          String   @id @default(cuid())
  deliveryId  String
  status      String
  timestamp   DateTime @default(now())
  description String
  location    String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}

model DeliveryMessage {
  id         String   @id @default(cuid())
  deliveryId String
  message    String
  response   String?
  createdAt  DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}

model OrderRating {
  id        String   @id @default(cuid())
  orderId   String   @unique
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderReturn {
  id        String   @id @default(cuid())
  orderId   String   @unique
  reason    String
  status    String   @default("pending") // pending, approved, rejected, completed
  items     String[] // Array of item IDs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
